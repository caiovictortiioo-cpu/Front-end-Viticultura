# Copie para um arquivo .env local ou exporte estas variáveis no shell.
# Não preencha nem versione credenciais reais neste exemplo.
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/agroclima
DATABASE_USER=agroclima
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=12
JWT_SECRET=
JWT_TTL_MINUTES=60
INITIAL_ADMIN_EMAIL=admin@agroclima.com
INITIAL_ADMIN_PASSWORD=
INTERNAL_API_KEY=
MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
