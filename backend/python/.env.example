# ThingSpeak
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_URL=https://api.thingspeak.com
# Configure as JSON; add/remove metrics according to the channel's field assignments.
THINGSPEAK_FIELD_MAP={"temperature":"field1","humidity":"field2","rainfall":"field3","luminosity":"field4","soilHumidity":"field5"}
THINGSPEAK_POLL_INTERVAL_SECONDS=300
THINGSPEAK_RESULTS_LIMIT=500

# URLs between containers. In a local non-Docker run, use http://localhost:8080.
JAVA_API_URL=http://java:8080
# Use the exact same >=32-character value as INTERNAL_API_KEY in backend/java/.env.
INTERNAL_API_KEY=

# Comma-separated explicit browser origins; do not use * for protected APIs.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
REQUEST_TIMEOUT_SECONDS=12
ENABLE_BACKGROUND_SYNC=true
