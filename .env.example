# Docker Compose only: copy to .env (never commit the filled file).
POSTGRES_DB=agroclima
POSTGRES_USER=agroclima
POSTGRES_PASSWORD=change-this-to-a-unique-long-database-password

# Use at least 32 random bytes for each key; use distinct values.
JWT_SECRET=replace-with-at-least-32-random-bytes-for-jwt-signing
INTERNAL_API_KEY=replace-with-another-at-least-32-random-bytes
INITIAL_ADMIN_EMAIL=admin@agroclima.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_TTL_MINUTES=60
MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ThingSpeak integration (optional until a channel is configured).
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_URL=https://api.thingspeak.com
THINGSPEAK_FIELD_MAP={"temperature":"field1","humidity":"field2","rainfall":"field3","luminosity":"field4","soilHumidity":"field5"}
THINGSPEAK_POLL_INTERVAL_SECONDS=300
THINGSPEAK_RESULTS_LIMIT=500

# Browser origins for direct API development. Main frontend uses same-origin proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
JAVA_PORT=8080
PYTHON_PORT=8000
FRONTEND_PORT=8081
